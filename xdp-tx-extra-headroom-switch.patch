From a05f863b7aee6ee5c983e586bdc5bf5c858d00d5 Mon Sep 17 00:00:00 2001
From: Tianyi Gao <tianyi@cloudflare.com>
Date: Wed, 18 Nov 2026 23:40:07 +0000
Subject: [PATCH] net: benchmark switch for the XDP part of tx_extra_headroom

Not for upstream. The benchmark turns the XDP part of tx_extra_headroom
off and on in the same kernel, so both sides run the same binary:

  echo 0 > /sys/module/kernel/parameters/xdp_tx_extra_headroom

The value is read when XDP is attached or detached. With 0, generic XDP
on a veth peer copies every locally generated packet again, as on a
kernel without the series.
---
 net/core/dev.c | 7 ++++++-
 1 file changed, 6 insertions(+), 1 deletion(-)

diff --git a/net/core/dev.c b/net/core/dev.c
index 6c655b0a949e..aacae9810b5d 100644
--- a/net/core/dev.c
+++ b/net/core/dev.c
@@ -10678,13 +10678,18 @@ u32 dev_xdp_prog_id(struct net_device *dev, enum bpf_xdp_mode mode)
 	return prog ? prog->aux->id : 0;
 }
 
+/* Benchmark only: 0 makes XDP on the peer set no tx_extra_headroom. */
+static bool xdp_tx_extra_headroom = true;
+core_param(xdp_tx_extra_headroom, xdp_tx_extra_headroom, bool, 0644);
+
 static void __netdev_update_tx_extra_headroom(struct net_device *dev,
 					      struct net_device *peer)
 {
 	unsigned int needed_headroom = READ_ONCE(dev->needed_headroom);
 	unsigned int tx_extra_headroom = 0;
 
-	if (peer && dev_xdp_prog_count(peer) &&
+	if (READ_ONCE(xdp_tx_extra_headroom) &&
+	    peer && dev_xdp_prog_count(peer) &&
 	    needed_headroom < XDP_PACKET_HEADROOM)
 		tx_extra_headroom = XDP_PACKET_HEADROOM - needed_headroom;
 	tx_extra_headroom += tcx_tx_extra_headroom(dev);
